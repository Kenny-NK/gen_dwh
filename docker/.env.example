# PostgreSQL
POSTGRES_SYSTEM_PASSWORD=replace_with_strong_system_password
POSTGRES_BUSINESS_PASSWORD=replace_with_strong_business_password
POSTGRES_SYSTEM_HOST_PORT=5432
POSTGRES_BUSINESS_HOST_PORT=15433
DB_ENCRYPTION_KEY=replace_with_32_plus_char_encryption_key

# Redis
REDIS_PASSWORD=replace_with_strong_redis_password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_strong_admin_password
KC_HOSTNAME=localhost
KC_SSL_REQUIRED=none
FRONTEND_URL=http://localhost:5173
KEYCLOAK_BOOTSTRAP_USER=admin
KEYCLOAK_BOOTSTRAP_PASSWORD=
KEYCLOAK_BOOTSTRAP_EMAIL=admin@gendwh.local
BOOTSTRAP_TENANT_SUBDOMAIN=acme
BOOTSTRAP_TENANT_NAME=Acme_Corp
BOOTSTRAP_TENANT_SCHEMA=tenant_acme

# Application
APP_SECRET_KEY=replace_with_strong_app_secret
ENFORCE_SECURE_SECRETS=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WINDOW_SECONDS=60
STALE_PENDING_RUN_MINUTES=15
JWKS_CACHE_TTL_SECONDS=3600
HTTP_CLIENT_TIMEOUT_SECONDS=5
EXTERNAL_CA_BUNDLE_PATH=/opt/gendwh/certs/external-ca.pem
ALLOW_REALM_TENANT_FALLBACK=true
# For production, replace localhost with your deployed frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_NAME=gendwh_access_token
AUTH_COOKIE_MAX_AGE_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gendwh
KEYCLOAK_CLIENT_ID=gendwh-app
# Leave empty for public clients; set only if you switch Keycloak to confidential client mode.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/gendwh
